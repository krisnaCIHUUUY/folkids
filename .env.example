# Supabase — salin file ini ke .env.local lalu isi nilai sebenarnya.
# Dapatkan dari https://supabase.com/dashboard/project/<your-project>/settings/api

# URL project Supabase (boleh terekspos di client)
NEXT_PUBLIC_SUPABASE_URL=

# Anon public key (boleh terekspos di client, dibatasi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — BYPASS RLS. JANGAN PERNAH expose ke client.
# Hanya import dari Server Actions / API Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=
